{
  "url": "https://course.spacy.io/pt/chapter1",
  "formats": [
    "markdown",
    "links",
    "images"
  ],
  "onlyMainContent": true,
  "onlyCleanContent": true,
  "waitFor": 0,
  "timeout": 120000,
  "removeBase64Images": true,
  "blockAds": true,
  "proxy": "auto",
  "storeInCache": true,
  "maxAge": 0,
  "location": {
    "country": "US",
    "languages": [
      "en-US"
    ]
  },
  "excludeTags": [
    "nav",
    "footer",
    "aside",
    "script",
    "style",
    "noscript",
    "form"
  ],
  "parsers": [
    {
      "type": "pdf",
      "mode": "auto"
    }
  ]
}
