DATABASE_URL=postgresql://universe:universe@localhost:5433/universe
UNIVERSE_POSTGRES_PORT=5433

# Interpretation/harness calls and visual source descriptions. The model id is
# passed per harness run (--model); manual images and relevant article images
# use the explicit vision-model setting below.
MODEL_API_BASE=https://openrouter.ai/api/v1
MODEL_API_KEY=
# The model client accepts the CG Pipeline spelling below and the legacy
# OPEN_ROUTER_API_KEY spelling as fallbacks for MODEL_API_KEY.
OPENROUTER_API_KEY=

# Forced structured description/transcription for source images. Must be a
# vision-capable model available through MODEL_API_BASE.
CONCEPT_UNIVERSE_MANUAL_IMAGE_MODEL=google/gemini-2.5-flash
CONCEPT_UNIVERSE_ARTICLE_IMAGE_MODEL=google/gemini-2.5-flash
CONCEPT_UNIVERSE_MAX_ARTICLE_IMAGES=12

# Implemented source acquisition provider: public articles and opted-in private
# PDF uploads via Firecrawl. Keep private uploads disabled until the deployment
# has an explicit document-export policy and the upload consent UI is present.
FIRECRAWL_API_KEY=
FIRECRAWL_ALLOW_PRIVATE_PDF_UPLOADS=0
# Firecrawl does not currently emit vector diagrams as images. This separate
# consent gate permits candidate page renders to be sent to the configured
# OpenRouter vision model solely to locate tight figure crops.
OPENROUTER_ALLOW_PRIVATE_PDF_PAGE_UPLOADS=0

# Immutable source binaries live outside Postgres. Local development uses this
# application-managed filesystem root. Set the AWS/Railway values instead in
# production to use an S3-compatible bucket.
CONCEPT_UNIVERSE_ASSET_ROOT=.data/source-assets
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=
AWS_S3_URL_STYLE=

# Reserved for future Adapter ports. Setting these does not currently enable
# video, book/Sophia, Browserbase, or caption acquisition. Manual PDF/image
# acquisition uses the model variables above.
BROWSERBASE_API_KEY=
SOPHIA_TERMINAL_URL=https://philos.sophia.com.br/terminal/9418
CG_PIPELINE_LIBRARY_USERNAME=
CG_PIPELINE_LIBRARY_PASSWORD=

# Durable acquisition worker. The web app may run one local worker; Railway
# can run the same worker command as a separate service.
ACQUISITION_POLL_SECONDS=1.0
ACQUISITION_STALE_MINUTES=15
# `python serve.py` enables the worker itself. Set this only when an ASGI
# server imports `universe.web.app:app` directly; leave it off if Railway runs
# `python -m universe.acquisition work --forever` as a separate worker.
ACQUISITION_WORKER_IN_WEB=0

# Optional call limits.
CONCEPT_UNIVERSE_MODEL_MAX_TOKENS=8000
CONCEPT_UNIVERSE_MODEL_TIMEOUT_SECONDS=300
