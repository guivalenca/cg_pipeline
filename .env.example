DATABASE_URL=postgresql://universe:universe@localhost:5433/universe
UNIVERSE_POSTGRES_PORT=5433
UNIVERSE_WEB_PORT=8100

# Optional Companion namespace seam. Compose uses the checked-in pilot snapshot;
# leave the file blank for local sibling-checkout discovery.
COMPANION_GRAPH_NAMESPACE_FILE=
COMPANION_DATABASE_URL=
COMPANION_PLATFORM_SCHEMA=
COMPANION_REPO=
COMPANION_PYTHON=python3

# Model calls used by visual analysis, reconstruction, and source cleanup.
MODEL_API_BASE=https://openrouter.ai/api/v1
MODEL_API_KEY=
OPENROUTER_API_KEY=
CONCEPT_UNIVERSE_ARTICLE_IMAGE_MODEL=google/gemini-2.5-flash
CONCEPT_UNIVERSE_SOURCE_CLEANUP_MODEL=deepseek/deepseek-v4-flash
CONCEPT_UNIVERSE_SOURCE_CLEANUP_FALLBACK_MODEL=google/gemini-2.5-flash
CONCEPT_UNIVERSE_SOURCE_CLEANUP_TIMEOUT_SECONDS=90
CONCEPT_UNIVERSE_MODEL_MAX_TOKENS=8000
CONCEPT_UNIVERSE_MODEL_TIMEOUT_SECONDS=300

# YouTube evidence and visual teaching beats.
CONCEPT_UNIVERSE_VIDEO_CAPTION_LANGUAGES=pt-BR,pt,en-US,en
CONCEPT_UNIVERSE_VIDEO_STT_MODEL=openai/whisper-large-v3
CONCEPT_UNIVERSE_VIDEO_STT_FALLBACK_MODEL=openai/whisper-1
CONCEPT_UNIVERSE_VIDEO_STT_CHUNK_SECONDS=60
CONCEPT_UNIVERSE_VIDEO_STT_WORKERS=2
CONCEPT_UNIVERSE_VIDEO_STT_TIMEOUT_SECONDS=300
CONCEPT_UNIVERSE_VIDEO_TEACHING_BEAT_MODEL=google/gemini-2.5-flash

# Public articles and explicitly authorized private PDF processing.
FIRECRAWL_API_KEY=
FIRECRAWL_ALLOW_PRIVATE_PDF_UPLOADS=0
OPENROUTER_ALLOW_PRIVATE_PDF_PAGE_UPLOADS=0

# Immutable source bytes use only this content-addressed local filesystem.
CONCEPT_UNIVERSE_ASSET_ROOT=.data/source-assets

# Authenticated book acquisition. The Browserbase context is guarded by a
# host-local file lease; run at most one book worker per shared filesystem.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_CONTEXT_ID=
BROWSERBASE_CONTEXT_FILE=.data/browserbase_context.json
BROWSERBASE_REGION=us-west-2
BROWSERBASE_TIMEOUT_SECONDS=3600
BROWSERBASE_LOCK_WAIT_SECONDS=3720
SOPHIA_TERMINAL_URL=https://philos.sophia.com.br/terminal/9418
CG_PIPELINE_LIBRARY_USERNAME=
CG_PIPELINE_LIBRARY_PASSWORD=

# PostgreSQL-backed scheduler and claim leases.
ACQUISITION_POLL_SECONDS=1.0
ACQUISITION_STALE_MINUTES=15
ACQUISITION_WORKER_IN_WEB=0
