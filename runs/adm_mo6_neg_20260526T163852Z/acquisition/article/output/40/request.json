{
  "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC5579088",
  "formats": [
    "markdown",
    "links",
    "images",
    {
      "type": "screenshot",
      "fullPage": true,
      "quality": 70,
      "viewport": {
        "width": 1440,
        "height": 1400
      }
    }
  ],
  "onlyMainContent": true,
  "onlyCleanContent": true,
  "waitFor": 0,
  "timeout": 120000,
  "removeBase64Images": true,
  "blockAds": true,
  "proxy": "auto",
  "storeInCache": true,
  "maxAge": 0,
  "location": {
    "country": "US",
    "languages": [
      "en-US"
    ]
  },
  "excludeTags": [
    "nav",
    "footer",
    "aside",
    "script",
    "style",
    "noscript",
    "form"
  ],
  "parsers": [
    {
      "type": "pdf",
      "mode": "auto"
    }
  ]
}
